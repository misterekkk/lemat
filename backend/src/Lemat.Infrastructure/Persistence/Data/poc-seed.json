                "latex": "0{,}8x = 640",
                "komentarz": "równanie opisujące cenę po obniżce"
              },
              {
                "nr": 2,
                "latex": "x = \\frac{640}{0{,}8} = 800",
                "komentarz": "cena przed obniżką"
