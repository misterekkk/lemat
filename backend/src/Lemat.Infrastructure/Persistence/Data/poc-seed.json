      "punkty_max": 2,
      "tresc_md": "Cena roweru po obniżce o $20\\%$ wynosi $640$ zł. Oblicz cenę roweru przed obniżką.",
      "rozwiazanie_wzorcowe": {
        "warianty": [
          {
