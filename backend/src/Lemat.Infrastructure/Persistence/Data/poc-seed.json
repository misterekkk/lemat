    {
      "zadanie_id": "a1000000-0000-4000-8000-000000000004",
      "zadanie_wersja_id": "b1000000-0000-4000-8000-000000000004",
      "dzial_id": 7,
      "umiejetnosc_id": 701,
      "poziom_trudnosci": 3,
      "punkty_max": 3,
      "tresc_md": "Kąt $\\alpha$ jest ostry i $\\sin\\alpha = \\frac{3}{5}$. Oblicz $\\cos\\alpha$ oraz $\\operatorname{tg}\\alpha$.",
      "rozwiazanie_wzorcowe": {
        "warianty": [
          {
            "wariant": 1,
            "opis": "Rozwiązanie wzorcowe",
            "kroki": [
              {
                "nr": 1,
                "latex": "\\cos^2\\alpha = 1 - \\sin^2\\alpha = 1 - \\frac{9}{25} = \\frac{16}{25}",
                "komentarz": "jedynka trygonometryczna"
              },
              {
                "nr": 2,
                "latex": "\\cos\\alpha = \\frac{4}{5}",
                "komentarz": "kąt ostry, więc cosinus dodatni"
              },
              {
                "nr": 3,
                "latex": "\\operatorname{tg}\\alpha = \\frac{\\sin\\alpha}{\\cos\\alpha} = \\frac{3}{4}",
                "komentarz": "tangens"
              }
            ]
          }
        ]
      },
      "wynik_koncowy_wzorcowy": {
        "typ": "ZBIOR",
        "latex": "\\cos\\alpha = \\frac{4}{5},\\ \\operatorname{tg}\\alpha = \\frac{3}{4}",
        "postac_sympy": "[4/5, 3/4]"
      },
      "kryteria": [
        {
          "wariant": 1,
          "nr_kryterium": 1,
          "opis": "Zastosowanie jedynki trygonometrycznej: $\\cos^2\\alpha = \\frac{16}{25}$.",
          "punkty_max": 1,
          "czy_wynik_koncowy": false,
          "wymaga_nr_kryterium": null
        },
        {
          "wariant": 1,
          "nr_kryterium": 2,
          "opis": "Obliczenie $\\cos\\alpha = \\frac{4}{5}$.",
          "punkty_max": 1,
          "czy_wynik_koncowy": false,
          "wymaga_nr_kryterium": 1
        },
        {
          "wariant": 1,
          "nr_kryterium": 3,
          "opis": "Obliczenie $\\operatorname{tg}\\alpha = \\frac{3}{4}$.",
          "punkty_max": 1,
          "czy_wynik_koncowy": true,
          "wymaga_nr_kryterium": 2
        }
      ]
    },
    {
      "zadanie_id": "a1000000-0000-4000-8000-000000000005",
