  "zadania": [
    {
      "zadanie_id": "a1000000-0000-4000-8000-000000000001",
      "zadanie_wersja_id": "b1000000-0000-4000-8000-000000000001",
      "dzial_id": 5,
      "umiejetnosc_id": 502,
      "poziom_trudnosci": 2,
      "punkty_max": 2,
      "tresc_md": "Dana jest funkcja kwadratowa $f(x) = -x^2 + 4x - 3$. Oblicz współrzędne wierzchołka paraboli będącej wykresem funkcji $f$ i podaj największą wartość funkcji $f$.",
      "rozwiazanie_wzorcowe": {
        "warianty": [
          {
            "wariant": 1,
            "opis": "Rozwiązanie wzorcowe",
            "kroki": [
              {
                "nr": 1,
                "latex": "p = -\\frac{b}{2a} = -\\frac{4}{-2} = 2",
                "komentarz": "odcięta wierzchołka"
              },
              {
                "nr": 2,
                "latex": "q = f(2) = -4 + 8 - 3 = 1",
                "komentarz": "rzędna wierzchołka"
              },
              {
                "nr": 3,
                "latex": "W = (2, 1),\\ f_{\\max} = 1",
                "komentarz": "największa wartość, bo $a < 0$"
              }
            ]
          }
        ]
      },
      "wynik_koncowy_wzorcowy": {
        "typ": "WYRAZENIE",
        "latex": "1",
        "postac_sympy": "1"
      },
      "kryteria": [
        {
          "wariant": 1,
          "nr_kryterium": 1,
          "opis": "Obliczenie odciętej wierzchołka paraboli: $p = 2$.",
          "punkty_max": 1,
          "czy_wynik_koncowy": false,
          "wymaga_nr_kryterium": null
        },
        {
          "wariant": 1,
          "nr_kryterium": 2,
          "opis": "Podanie największej wartości funkcji: $f(2) = 1$.",
          "punkty_max": 1,
          "czy_wynik_koncowy": true,
          "wymaga_nr_kryterium": 1
        }
      ]
    },
    {
      "zadanie_id": "a1000000-0000-4000-8000-000000000002",
      "zadanie_wersja_id": "b1000000-0000-4000-8000-000000000002",
      "dzial_id": 3,
      "umiejetnosc_id": 301,
      "poziom_trudnosci": 1,
      "punkty_max": 2,
      "tresc_md": "Rozwiąż równanie $x^2 - 5x + 6 = 0$.",
      "rozwiazanie_wzorcowe": {
        "warianty": [
          {
            "wariant": 1,
            "opis": "Rozwiązanie wzorcowe",
            "kroki": [
              {
                "nr": 1,
                "latex": "\\Delta = 25 - 24 = 1",
                "komentarz": "wyróżnik"
              },
              {
                "nr": 2,
                "latex": "x_1 = \\frac{5 - 1}{2} = 2,\\ x_2 = \\frac{5 + 1}{2} = 3",
                "komentarz": "pierwiastki"
              }
            ]
          }
        ]
      },
      "wynik_koncowy_wzorcowy": {
        "typ": "ZBIOR",
        "latex": "x_1 = 2,\\ x_2 = 3",
        "postac_sympy": "[2, 3]"
      },
      "kryteria": [
        {
          "wariant": 1,
          "nr_kryterium": 1,
          "opis": "Obliczenie wyróżnika trójmianu: $\\Delta = 1$.",
          "punkty_max": 1,
          "czy_wynik_koncowy": false,
          "wymaga_nr_kryterium": null
        },
        {
          "wariant": 1,
          "nr_kryterium": 2,
          "opis": "Obliczenie pierwiastków równania: $x_1 = 2$, $x_2 = 3$.",
          "punkty_max": 1,
          "czy_wynik_koncowy": true,
          "wymaga_nr_kryterium": 1
        }
      ]
    },
    {
      "zadanie_id": "a1000000-0000-4000-8000-000000000003",
