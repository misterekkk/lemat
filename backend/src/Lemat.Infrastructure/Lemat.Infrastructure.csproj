<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Lemat.Application\Lemat.Application.csproj" />
    <ProjectReference Include="..\Lemat.Domain\Lemat.Domain.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <!-- Pliki SQL migracji wycięte z docs/spec/ddl.md przez backend/tools/extract-ddl.sh (ADR-063); ZasobSql.Wczytaj. -->
  <ItemGroup>
    <EmbeddedResource Include="Persistence\Migrations\Sql\*.sql" LogicalName="Lemat.Infrastructure.Persistence.Migrations.Sql.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Persistence\Data\poc-seed.json" LogicalName="Lemat.Infrastructure.Persistence.Data.poc-seed.json" />
    <EmbeddedResource Include="Persistence\Schema\ddl.sql" LogicalName="Lemat.Infrastructure.Persistence.Schema.ddl.sql" />
  </ItemGroup>
