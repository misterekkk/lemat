# Lemat frontend - zmienne srodowiskowe (TASK-132, TASK-138). Skopiuj do .env.local (ignorowany przez git).
# Tryb API: real (domyslnie) = proxy /api -> LEMAT_API_URL; mock = MSW w przegladarce (bez backendu).
# Zwykle wystarczaja skrypty: npm run dev:mock / npm run dev:real.
NEXT_PUBLIC_LEMAT_API=real
# Adres backendu dla rewrites /api/* (tylko tryb real; domyslnie http://localhost:5080).
LEMAT_API_URL=http://localhost:5080
# Opcjonalnie (tylko dev/E2E): scenariusz Mocka serwera wysylany w naglowku X-Lemat-Mock-Scenariusz
# przy POST /rozwiazania, np. rozpoznanie-nieczytelne. Nie ustawiaj w produkcji.
# NEXT_PUBLIC_LEMAT_MOCK_SCENARIUSZ=
