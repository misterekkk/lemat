# Lemat - zmienne srodowiskowe (TASK-005). Skopiuj do .env (plik .env jest ignorowany przez git).
# Brak sekretow: wartosci ponizej sa wylacznie deweloperskie albo puste. Nie commituj prawdziwych kluczy.
# W Development nic poza baza nie jest wymagane (Mocki dzialaja bez kluczy).

# --- Srodowisko ---
ASPNETCORE_ENVIRONMENT=Development
LEMAT_SRODOWISKO=
LEMAT_CZAS_TESTOWY=

# --- Baza (docker-compose / skrypty) ---
# Port hosta dla kontenera postgres (lokalny PostgreSQL zajmuje 5432)
LEMAT_PG_PORT=5433
LEMAT_PG_UZYTKOWNIK=lemat
LEMAT_PG_HASLO=lemat_dev
# Connection string aplikacji i roli migracji (puste = wartosc z appsettings.Development.json)
LEMAT_BAZA=
LEMAT_BAZA_MIGRACJE=
# Baza testow integracyjnych zamiast Testcontainers (opcjonalnie)
LEMAT_TEST_BAZA=

# --- Frontend ---
LEMAT_API_URL=http://localhost:5080

# --- Modele AI (puste = Mock) ---
# openai-zgodny | azure-openai | anthropic | mock
LEMAT_MODELE_DOSTAWCA=
LEMAT_MODELE_KLUCZ_API=
LEMAT_MODELE_ENDPOINT=
# Wymagane dla dostawcy innego niz mock (A-07, 409 BRAK_RETENCJI_DOSTAWCY)
LEMAT_POTWIERDZONA_RETENCJA_DOSTAWCY=
LEMAT_MOCK_OPOZNIENIE_MS=

# --- Magazyn lokalny (U-03) ---
# Katalog zdjec kartek (puste = dev-up.sh uzywa ./storage/magazyn)
LEMAT_MAGAZYN_SCIEZKA=

# --- Klucze (wymagane tylko w Production; w Development generowane) ---
LEMAT_JWT_KLUCZ=
LEMAT_KURSOR_KLUCZ=
# Klucz HMAC podpisu adresow zdjec w magazynie lokalnym (Development: klucz domyslny)
LEMAT_MAGAZYN_KLUCZ=

# --- Potok POC (TASK-128/130; zmienne ASP.NET Core z "__", puste/zakomentowane = wartosci domyslne) ---
# Lemat:Poc:OpoznienieRozpoznaniaMs - czas statusu ROZPOZNAWANIE (domyslnie 3000)
# Lemat:Poc:OpoznienieOcenyMs       - czas statusu OCENIANIE (domyslnie 2000)
# Lemat:Poc:OdpytanieMs             - odstep odpytywania praca_w_tle przez Worker (domyslnie 500)
# Lemat:Poc:DzierzawaSekund         - dzierzawa pracy w tle (domyslnie 60)
# Lemat:Poc:OdstepPonowieniaMs      - odstep przed ponowieniem pracy z bledem (domyslnie 2000)
#Lemat__Poc__OpoznienieRozpoznaniaMs=3000
#Lemat__Poc__OpoznienieOcenyMs=2000
#Lemat__Poc__OdpytanieMs=500

# --- Konta ---
# Tylko Development
LEMAT_KONTA_AUTOZATWIERDZANIE_NAUCZYCIELI=
LEMAT_REJESTRACJA_BEZ_KLASY=
